{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "lab-flap",
      "folder": "Lab",
      "interval": "10s",
      "rules": [
        {
          "uid": "lab-pulse",
          "title": "Lab Pulse",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "testdata",
              "model": {
                "refId": "A",
                "scenarioId": "predictable_pulse",
                "intervalMs": 1000,
                "maxDataPoints": 100,
                "pulseWave": {
                  "timeStep": 10,
                  "onCount": 6,
                  "offCount": 4,
                  "onValue": 1,
                  "offValue": 0
                }
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "0s",
          "labels": {
            "team": "sre",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Lab Pulse"
          }
        },
